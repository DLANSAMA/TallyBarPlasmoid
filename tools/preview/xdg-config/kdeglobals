# Hermetic desktop config for the offscreen screenshot renders (Makefile SHOT_ENV and
# tests/test_qml_render.py point XDG_CONFIG_HOME here). With QT_QPA_PLATFORMTHEME=kde the
# icon theme comes from kdeglobals, so without this file the refresh, gear and close glyphs
# would follow whatever theme the developer's desktop has. breeze-dark is KDE's default dark
# theme and ships with Plasma, so every KDE machine can reproduce it.
[Icons]
Theme=breeze-dark
